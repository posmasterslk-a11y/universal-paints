<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent Directory Listing
    Options -Indexes

    # Block access to .env and other hidden files
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Allow direct access to /admin (Admin SPA)
    RewriteCond %{REQUEST_URI} ^/admin [NC]
    RewriteRule ^ - [L]

    # Forward all other requests to the public/ folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
