<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent infinite loop: if already rewritten to public/, stop!
    RewriteRule ^public/ - [L]

    # Allow direct access to /admin
    RewriteRule ^admin(/.*)?$ - [L]

    # Allow direct access to extract deployment scripts
    RewriteRule ^(extract.*\.php)$ - [L]

    # Rewrite root / to public/index.php
    RewriteRule ^$ public/index.php [L]

    # Rewrite all other requests to public/
    RewriteRule ^((?!public/).*)$ public/$1 [L]
</IfModule>
