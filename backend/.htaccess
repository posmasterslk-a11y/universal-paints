<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Block access to .env and other hidden files
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Allow /admin and existing files/directories in public_html to be served directly
    RewriteCond %{REQUEST_URI} ^/admin [NC,OR]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Forward all other requests to the public/ folder
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
